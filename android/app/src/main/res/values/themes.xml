<resources>
    <style name="Theme.Overwatch" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ow_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Overwatch.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ow_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Overwatch</item>
    </style>
</resources>
